@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Daily capture reminder

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Shows notifications to the owner")
  Container(api, "Cullr API", "Next.js route handlers", "Hosts the scheduled reminder job")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Settings, ideas and notifications")
}
Rel(owner, spa, "Reads reminder in", "HTTPS")
Rel(spa, api, "Fetches notifications from", "JSON/HTTPS")
Rel(api, db, "Reads settings and ideas, writes notifications", "<TO SUPPLY>")
@enduml
