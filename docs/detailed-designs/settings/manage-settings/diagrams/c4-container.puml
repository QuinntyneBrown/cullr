@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage settings

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Settings screen at /settings")
  Container(api, "Cullr API", "Next.js route handlers", "Reads and validates settings")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Stores the owner's preferences")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
