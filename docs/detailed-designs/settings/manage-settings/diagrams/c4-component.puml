@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage settings

Container_Boundary(spa, "Cullr web app") {
  Component(page, "SettingsPage", "Angular page component", "Renders the form and its states")
  Component(client, "SettingsApi", "Typed API client service", "Calls the settings endpoints")
}
Container_Boundary(api, "Cullr API") {
  Component(handler, "SettingsRouteHandler", "Next.js route handler", "Exposes GET and PUT /api/settings")
  Component(get, "GetSettingsUseCase", "Application use case", "Loads the saved settings")
  Component(save, "SaveSettingsUseCase", "Application use case", "Validates and persists settings")
  Component(entity, "OwnerSettings", "Domain entity", "Holds preferences and enforces the threshold rule")
  Component(repo, "SettingsRepository", "Infrastructure repository", "Reads and writes OwnerSettings")
}
ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Stores the owner's preferences")

Rel(page, client, "Uses")
Rel(client, handler, "Calls", "JSON/HTTPS")
Rel(handler, get, "Invokes")
Rel(handler, save, "Invokes")
Rel(get, repo, "Loads through")
Rel(save, entity, "Applies L2-026 validation with")
Rel(save, repo, "Persists through")
Rel(repo, db, "Reads and writes", "<TO SUPPLY>")
@enduml
