@startuml
title UML sequence behaviour — Load settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "SettingsPage" as page
  participant "SettingsService" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "SettingsRouteHandler" as handler
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "GetSettingsUseCase" as usecase
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  participant "SettingsRepository" as repo
  database "Cullr database" as db
end box
owner -> page : Open /settings
page -> page : Show skeleton (L2-026 criterion 5)
page -> client : get()
client -> handler : GET /api/settings
handler -> usecase : execute()
usecase -> repo : load()
repo -> db : Read saved settings
alt load succeeds
  db --> repo : Stored values
  repo --> usecase : OwnerSettings
  usecase --> handler : OwnerSettings
  handler --> client : 200 with settings
  client --> page : OwnerSettings
  page --> owner : Show saved values (L2-026 criterion 1)
else load fails
  db --> repo : Error
  repo --> usecase : Error
  usecase --> handler : Error
  handler --> client : Problem response
  client --> page : Error
  page --> owner : Show error with Try again (L2-026 criterion 5)
end
@enduml
