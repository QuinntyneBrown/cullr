@startuml
title UML sequence behaviour — Apply theme
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "ThemeService" as theme
  participant "SettingsService" as client
  participant "SunTimesSource <TO SUPPLY>" as sun
  participant "Browser document" as doc
end box
box "Backend — Cullr API" #D1FADF
  participant "SettingsRouteHandler" as handler
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "GetSettingsUseCase" as usecase
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> theme : Open Cullr
theme -> client : get()
client -> handler : GET /api/settings
handler -> usecase : execute()
usecase -> db : Read autoDarkThemeEnabled
db --> usecase : Stored value
usecase --> handler : OwnerSettings
handler --> client : 200 with settings
client --> theme : autoDarkEnabled
theme -> doc : Read prefers-color-scheme
doc --> theme : systemPrefersDark
alt automatic dark theme on
  theme -> sun : Get sunrise and sunset for local day
  sun --> theme : SunTimes
  alt local time between sunset and sunrise, or system prefers dark
    theme -> doc : Apply L2-028 dark theme
  else otherwise
    theme -> doc : Apply L2-028 light theme
  end
else automatic dark theme off
  alt system prefers dark
    theme -> doc : Apply L2-028 dark theme
  else otherwise
    theme -> doc : Apply L2-028 light theme
  end
end
doc --> owner : Render themed screen
@enduml
