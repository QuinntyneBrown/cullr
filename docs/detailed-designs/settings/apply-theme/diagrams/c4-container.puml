@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Apply theme

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Chooses and applies the theme in the browser")
  Container(api, "Cullr API", "Next.js route handlers", "Serves the saved settings")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Stores the automatic dark theme preference")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Reads settings from", "JSON/HTTPS")
Rel(api, db, "Reads", "<TO SUPPLY>")
@enduml
