@startuml
title UML sequence behaviour — Change the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "ChangePasswordFormComponent" as page
  participant "AccountService" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "change password route handler" as route
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "ChangePasswordUseCase" as uc
  participant "OwnerAccount" as acct
  participant "PasswordPolicy" as policy
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> page : Enter current, new and confirmation, submit
alt confirmation differs
  page --> owner : Show inline error, send no request (L2-031)
else fields complete
  page -> page : Disable submit, show busy state
  page -> client : Build request
  client -> route : POST /api/account/password
  route -> uc : Invoke ChangePasswordUseCase
  uc -> db : Load account
  db --> uc : Account
  uc -> acct : Verify current password
  alt current password wrong
    acct --> uc : Mismatch
    uc --> route : Rejected
    route --> client : 422
    client --> page : Error
    page --> owner : Show inline error on current password (L2-031)
  else current password correct
    uc -> policy : Check new password (L2-046)
    alt policy fails
      policy --> uc : Reason
      uc --> route : Rejected with reason
      route --> client : 422
      client --> page : Error
      page --> owner : Show inline policy error, change nothing (L2-031)
    else policy passes
      uc -> acct : Store new hash
      uc -> db : Save account and revoke every other session
      db --> uc : Saved
      uc --> route : Changed
      route --> client : 200
      client --> page : Success
      page --> owner : Show success message (L2-031)
    end
  end
end
@enduml
