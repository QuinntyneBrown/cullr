@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Change password

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Change password form on the Account screen")
  Container(api, "Cullr API", "Next.js route handlers", "Verifies and changes the password")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Owner account and sessions")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Sends password change to", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
