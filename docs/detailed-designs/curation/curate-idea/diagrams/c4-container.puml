@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Curate an idea

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(web, "Cullr web app", "Angular single-page app", "Hosts the Curate idea dialog")
  Container(api, "Cullr API", "Next.js route handlers", "Curation use cases and domain rules")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas, best-of entries and notifications")
}
Rel(owner, web, "Chooses a period in", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
