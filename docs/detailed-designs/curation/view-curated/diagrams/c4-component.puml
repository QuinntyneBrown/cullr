@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Curated screen

Container_Boundary(web, "Cullr web app") {
  Component(page, "CuratedPageComponent", "Angular page component", "Renders list, filter chips and the loading, empty, error and no-results states")
  Component(client, "CurationApiClient", "Typed Angular HTTP client", "Fetches the curated list")
}
Container_Boundary(api, "Cullr API") {
  Component(handler, "curated route handler", "Next.js route handler", "Authenticates and returns the list")
  Component(usecase, "GetCuratedUseCase", "Application use case", "Builds the ordered curated list")
  Component(order, "CuratedOrdering", "Domain function", "Orders periods and scores")
  Component(repo, "BestOfRepository", "Repository", "Reads current best-of entries with their ideas")
}
ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Persists state")

Rel(page, client, "Calls")
Rel(client, handler, "GET", "JSON/HTTPS")
Rel(handler, usecase, "Invokes")
Rel(usecase, repo, "Reads through")
Rel(usecase, order, "Orders with")
Rel(repo, db, "Reads")
@enduml
