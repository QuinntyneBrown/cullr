@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Restore an idea

Container_Boundary(web, "Cullr web app") {
  Component(dialog, "RestoreIdeaDialogComponent", "Angular dialog component", "Confirms the restore and shows busy and failure states")
  Component(client, "IdeasService", "Typed Angular service", "Sends the restore request")
}

Container_Boundary(api, "Cullr API") {
  Component(handler, "RestoreIdeaRouteHandler", "Next.js route handler", "Exposes POST /api/ideas/{id}/restore")
  Component(usecase, "RestoreIdeaUseCase", "Application use case", "Loads, restores and saves the idea")
  Component(entity, "Idea", "Domain entity", "Owns the restore transition")
  Component(repo, "IdeaRepository", "Infrastructure repository", "Loads and saves ideas")
}
ComponentDb(db, "Cullr database", "<TO SUPPLY>", "Persists ideas")

Rel(dialog, client, "Calls")
Rel(client, handler, "POST", "JSON/HTTPS")
Rel(handler, usecase, "Invokes")
Rel(usecase, entity, "Calls Restore")
Rel(usecase, repo, "Loads and saves through")
Rel(repo, db, "Reads and writes", "<TO SUPPLY>")
@enduml
