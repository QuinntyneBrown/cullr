@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Restore an idea

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(web, "Cullr web app", "Angular single-page app", "Hosts the Restore idea dialog")
  Container(api, "Cullr API", "Next.js route handlers", "Applies the restore transition")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas")
}

Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
