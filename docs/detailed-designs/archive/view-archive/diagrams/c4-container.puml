@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the archive

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(web, "Cullr web app", "Angular single-page app", "Archive screen and read-only idea detail")
  Container(api, "Cullr API", "Next.js route handlers", "Lists archived ideas and rejects changes to them")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas, reasons and archive dates")
}

Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
