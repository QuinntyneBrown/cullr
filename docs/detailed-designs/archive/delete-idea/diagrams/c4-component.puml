@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Delete idea

Container_Boundary(spa, "Cullr web app") {
  Component(f0, "DeleteIdeaDialogComponent", "Angular dialog component", "Typed-title confirmation")
  Component(f1, "IdeasService", "Typed HTTP service", "Sends the delete request")
}
Container_Boundary(api, "Cullr API") {
  Component(a0, "delete route handler", "Next.js route handler", "DELETE /api/ideas/:id")
  Component(a1, "DeleteIdeaUseCase", "Application", "Checks and removes the idea")
  Component(a2, "Idea", "Domain entity", "Guards deletion to archived ideas")
  Component(r, "IdeaRepository", "Infrastructure", "Persist and load state")
}
ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Persists state")

Rel(f0, f1, "Calls")
Rel(f1, a0, "Sends request", "JSON/HTTPS")
Rel(a0, a1, "Invokes")
Rel(a1, a2, "Uses")
Rel(a1, r, "Loads and saves through")
Rel(r, db, "Reads and writes", "<TO SUPPLY>")
@enduml
