@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Notification center

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Notifications screen and bell")
  Container(api, "Cullr API", "Next.js route handlers", "Lists notifications and marks them read")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Notifications")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Requests and updates notifications through", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
