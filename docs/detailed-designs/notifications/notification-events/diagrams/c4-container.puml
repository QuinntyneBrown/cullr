@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Notification events

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Notifications screen shows the result")
  Container(api, "Cullr API", "Next.js route handlers", "Creates notifications for events")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Notifications, ideas and settings")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
