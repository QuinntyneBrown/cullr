@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Access control and rate limits

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Presents 401, 404 and 429 outcomes")
  Container(api, "Cullr API", "Next.js route handlers", "Throttles requests and authorizes every endpoint")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Stores sessions and ideas")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads sessions and ideas from", "Parameterised queries")
@enduml
