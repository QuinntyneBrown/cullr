@startuml
title UML sequence behaviour — Throttled and unauthenticated requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "IdeasPage" as page
  participant "ApiErrorInterceptor" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "RateLimiter" as limiter
  participant "withOwnerSession" as auth
  participant "GET /api/ideas/:id route handler" as handler
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "GetIdeaUseCase" as usecase
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> page : Open an idea
page -> client : Build typed request
client -> limiter : HTTPS request
limiter -> limiter : Count request for IP address or session (L2-044)
alt Auth endpoints over 10 per IP per minute, or API over 120 per session per minute
  limiter --> client : 429 with Retry-After header (L2-044)
  client --> page : Typed throttled error
  page --> owner : Show retry message
else Within limits
  limiter -> auth : Forward request
  auth -> auth : Check endpoint against public list
  alt No authenticated owner session
    auth --> client : 401 (L2-043)
    client --> page : Typed unauthorized error
    page --> owner : Show sign-in
  else Owner session valid
    auth -> db : Load session
    db --> auth : Session
    auth -> handler : Forward with owner id
    handler -> usecase : Execute
    usecase -> db : Find idea by id for the owner
    db --> usecase : Row or none
    alt Idea missing or not the owner's
      usecase --> handler : Not found
      handler --> client : 404 with identical body for both cases (L2-043)
      client --> page : Typed not-found error
      page --> owner : Show not-found page
    else Idea found
      usecase --> handler : Idea
      handler --> client : 200 with idea
      client --> page : Idea
      page --> owner : Show idea
    end
  end
end
@enduml
