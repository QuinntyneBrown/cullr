@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Performance budgets

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Build budgets, lazy routes and hashed assets")
  Container(api, "Cullr API", "Next.js route handlers", "Paged, indexed queries within the response budgets")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas with indexes")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
