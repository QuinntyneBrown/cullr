@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Observability

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Something went wrong screen shows the reference id")
  Container(api, "Cullr API", "Next.js route handlers", "Logs errors, reports health and runs migrations")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas and migration state")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
