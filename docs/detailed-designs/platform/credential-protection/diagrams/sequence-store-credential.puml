@startuml
title UML sequence behaviour — Store a password and a reset token
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Backend — Cullr API" #D1FADF
  participant "Credential caller" as caller
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "PasswordPolicy" as policy
  participant "PasswordHasher" as hasher
  participant "TokenHasher" as tokens
  participant "LogRedactor" as log
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
caller -> policy : check(new password) (L2-046)
alt shorter than 12 or breached
  policy --> caller : Rejected with the reason
else 12 to 128 characters and not breached
  policy --> caller : Accepted
  caller -> hasher : hash(password) (L2-045)
  hasher --> caller : Salted adaptive hash
  caller -> db : Store the hash only
end
caller -> tokens : issue() for a reset link
tokens --> caller : Token value and its hash
caller -> db : Store the token hash only (L2-045)
caller -> log : redact(log entry)
log --> caller : Entry without passwords, tokens or full idea text (L2-045)
@enduml
