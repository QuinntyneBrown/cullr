@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Navigation shell

Container_Boundary(spa, "Cullr web app") {
  Component(f0, "AppShellComponent", "Angular layout component", "Composes the shell parts")
  Component(f1, "TopBarComponent", "Angular component", "Search, bell and avatar")
  Component(f2, "SidebarNavigationComponent", "Angular component", "Primary navigation")
  Component(f3, "ShellService", "Angular HTTP service", "Loads the unread count")
}
Container_Boundary(api, "Cullr API") {
  Component(a0, "unread count route handler", "Next.js route handler", "GET /api/notifications/unread-count")
  Component(r, "NotificationRepository", "Infrastructure", "Persist and load state")
}
ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Persists state")

Rel(f0, f1, "Composes")
Rel(f0, f2, "Composes")
Rel(f1, f3, "Calls")
Rel(f3, a0, "Sends request", "JSON/HTTPS")
Rel(a0, r, "Loads and saves through")
Rel(r, db, "Reads and writes", "<TO SUPPLY>")
@enduml
