@startuml
title UML sequence behaviour — Navigate with the shell
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "AppShellComponent" as shell
  participant "TopBarComponent" as top
  participant "SidebarNavigationComponent" as side
  participant "ShellService" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "unread count route handler" as route
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> shell : Open any signed-in screen
shell -> top : Render search, bell and avatar
top -> client : unreadCount()
client -> route : GET /api/notifications/unread-count
route -> db : Count unread notifications
db --> route : Count
route --> client : 200
client --> top : Count
top --> owner : Show bell with count (L2-035)
shell -> side : Render navigation with the current item
side --> owner : Mark current item with aria-current="page" (L2-035)
owner -> side : Choose Ideas
side --> owner : Open Ideas, move aria-current to Ideas
owner -> top : Type in the search box
top --> owner : Open Ideas with the query
owner -> shell : Open Help
shell --> owner : Show how to capture, critique, curate and archive (L2-035)
@enduml
