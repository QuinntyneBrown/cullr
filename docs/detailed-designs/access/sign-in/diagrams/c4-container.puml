@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Sign in screen at /sign-in")
  Container(api, "Cullr API", "Next.js route handlers", "Authenticates the owner and issues the session")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Owner account, failed sign-in attempts and sessions")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Posts credentials to", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
