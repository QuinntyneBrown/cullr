@startuml
title UML sequence behaviour — Forgot password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "ForgotPasswordPageComponent" as page
  participant "AuthApiClient" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "forgot-password route handler" as route
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "RequestPasswordResetUseCase" as uc
  participant "PasswordResetToken" as token
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
  participant "EmailSender" as mailer
end box
participant "Email provider" as ext
owner -> page : Submit email
alt malformed or empty email
  page --> owner : Apply L2-003 inline error, send no request
else well-formed email
  page -> client : Build typed request
  client -> route : POST /api/auth/forgot-password
  route -> uc : Invoke RequestPasswordResetUseCase
  uc -> db : Load owner account by email
  db --> uc : Account or none
  alt email is the owner's
    uc -> token : Issue single-use token, 60-minute expiry (L2-003)
    token --> uc : Token
    uc -> db : Save token hash
    db --> uc : Saved
    uc -> mailer : Send exactly one reset email (L2-003)
    mailer -> ext : Deliver email with link
    ext --> mailer : Accepted
  else not the owner's email
    uc -> uc : Send nothing
  end
  alt service failure
    uc --> route : Failure
    route --> client : Error response
    client --> page : Error
    page --> owner : Show error state, keep email (L2-003)
  else completed
    uc --> route : Accepted
    route --> client : 202 same response for any email (L2-003)
    client --> page : Success
    page --> owner : Show "Check your email"
  end
end
@enduml
