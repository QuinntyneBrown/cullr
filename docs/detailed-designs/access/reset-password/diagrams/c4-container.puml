@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Reset password

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Reset password screen at /reset-password")
  Container(api, "Cullr API", "Next.js route handlers", "Validates the link, changes the password and revokes sessions")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Owner account, reset tokens and sessions")
}

Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
