@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Reset password

class ResetPasswordPageComponent {
  +newPassword: string
  +confirmation: string
  +state: default | submitting | invalid | success | error
  +submit(): void
}
class AuthApiClient {
  +checkResetLink(token: string): Observable<void>
  +resetPassword(token: string, newPassword: string): Observable<void>
}
class ResetPasswordUseCase {
  +checkLink(token: string, now: Date): LinkStatus
  +execute(token: string, newPassword: string, now: Date): ResetResult
}
class PasswordResetToken {
  +expiresAt: Date
  +usedAt: Date
  +isUsable(now: Date): boolean
  +markUsed(now: Date): void
}
class PasswordPolicy {
  +check(password: string): PolicyResult
}
class OwnerAccount {
  +passwordHash: string
  +changePassword(password: string): void
}
interface PasswordResetTokenRepository {
  +findByHash(hash: string): PasswordResetToken
  +save(token: PasswordResetToken): void
}
interface OwnerRepository {
  +save(account: OwnerAccount): void
}
interface SessionRepository {
  +deleteAll(): void
}

ResetPasswordPageComponent --> AuthApiClient : calls
AuthApiClient ..> ResetPasswordUseCase : via route handlers
ResetPasswordUseCase --> PasswordResetToken : checks
ResetPasswordUseCase ..> PasswordPolicy : uses
ResetPasswordUseCase --> OwnerAccount : changes
ResetPasswordUseCase --> PasswordResetTokenRepository
ResetPasswordUseCase --> OwnerRepository
ResetPasswordUseCase --> SessionRepository
@enduml
