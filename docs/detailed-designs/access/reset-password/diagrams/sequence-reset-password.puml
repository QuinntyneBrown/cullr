@startuml
title UML sequence behaviour — Reset password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "ResetPasswordPageComponent" as page
  participant "AuthApiClient" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "reset-password route handlers" as route
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "ResetPasswordUseCase" as uc
  participant "PasswordResetToken" as token
  participant "PasswordPolicy" as policy
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> page : Open reset link
page -> client : Check link
client -> route : GET /api/auth/reset-password
route -> uc : Invoke checkLink
uc -> db : Load token
db --> uc : Token or none
uc -> token : Check expiry and use
alt expired or already used
  token --> uc : Not usable
  uc --> page : Link invalid
  page --> owner : Apply L2-004 error state with Request a new link
else usable
  page --> owner : Show form
  owner -> page : Submit new password and confirmation
  alt confirmation differs
    page --> owner : Show "Passwords don't match", send no request (L2-004)
  else matches
    page -> client : Build typed request
    client -> route : POST /api/auth/reset-password
    route -> uc : Invoke execute
    uc -> policy : Apply L2-046 password policy
    policy --> uc : Accepted
    uc -> token : Recheck expiry and use (L2-004)
    token --> uc : Usable
    uc -> db : Save new hash, invalidate link, delete all sessions (L2-004)
    db --> uc : Committed in one unit of work
    uc --> route : Reset
    route --> client : 204
    client --> page : Success
    page --> owner : Show success state
  end
end
@enduml
