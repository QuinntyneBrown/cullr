@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Edit an idea

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Hosts the Edit idea dialog")
  Container(api, "Cullr API", "Next.js route handlers", "Validates and applies idea edits")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas, critique notes and status history")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Sends edits to", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
