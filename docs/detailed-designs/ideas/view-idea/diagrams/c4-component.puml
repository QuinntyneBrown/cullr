@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View an idea

Container_Boundary(spa, "Cullr web app") {
  Component(page, "IdeaDetailPage", "Angular page component", "Renders loading, loaded, error and not-found states")
  Component(client, "IdeasService", "Typed Angular HTTP service", "Requests one idea by id")
}
Container_Boundary(api, "Cullr API") {
  Component(route, "GET /api/ideas/[id] route handler", "Next.js route handler", "Authenticates and maps the result to HTTP")
  Component(usecase, "GetIdeaUseCase", "Application use case", "Loads one idea with its history")
  Component(entity, "Idea", "Domain entity", "Holds fields, critique notes and status history")
  Component(repo, "IdeaRepository", "Infrastructure repository", "Reads an idea by id")
}
ComponentDb(db, "Cullr database", "<TO SUPPLY>", "Persists ideas")

Rel(page, client, "Calls")
Rel(client, route, "GET", "JSON/HTTPS")
Rel(route, usecase, "Invokes")
Rel(usecase, repo, "Loads through")
Rel(repo, entity, "Rehydrates")
Rel(repo, db, "Reads", "<TO SUPPLY>")
@enduml
