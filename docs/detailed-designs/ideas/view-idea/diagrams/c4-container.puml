@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View an idea

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Renders the Idea detail screen")
  Container(api, "Cullr API", "Next.js route handlers", "Returns one idea with critique notes and status history")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas, critique notes and status history")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads", "<TO SUPPLY>")
@enduml
