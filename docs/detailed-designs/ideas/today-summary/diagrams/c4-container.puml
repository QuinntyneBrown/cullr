@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Today summary

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Today screen at /")
  Container(api, "Cullr API", "Next.js route handlers", "Builds the Today summary")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas, best-of marks and owner time zone")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads", "<TO SUPPLY>")
@enduml
