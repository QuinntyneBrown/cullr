@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Capture an idea

Person(owner, "Owner", "Sole user of Cullr")
System_Boundary(cullr, "Cullr") {
  Container(spa, "Cullr web app", "Angular single-page app", "Capture idea dialog on Today and Ideas")
  Container(api, "Cullr API", "Next.js route handlers", "Validates and saves captured ideas")
  ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Ideas and capture request keys")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
