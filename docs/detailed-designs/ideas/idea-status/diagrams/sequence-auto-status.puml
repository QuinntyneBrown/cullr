@startuml
title UML sequence behaviour — Automatic status changes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "Edit and Curate dialogs" as page
end box
box "Backend — Cullr API" #D1FADF
  participant "edit and curate route handlers" as route
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "Edit and curate use cases" as uc
  participant "StatusPolicy" as policy
  participant "Idea" as idea
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> page : Save non-empty notes, or curate an idea
page -> route : Send the edit or curate request
route -> uc : Invoke the use case
uc -> db : Load idea
db --> uc : Idea
alt notes saved on a Logged idea
  uc -> policy : afterNotesSaved (L2-014)
  policy --> uc : Critiquing
else curated while Logged or Critiquing
  uc -> policy : afterCurated (L2-014)
  policy --> uc : Curating
else status is Curating, Building or Built
  uc -> policy : Ask for automatic status
  policy --> uc : Unchanged, never an earlier status (L2-014)
end
uc -> idea : setStatus and append history entry when changed
uc -> db : Save
db --> uc : Saved
uc --> route : Result
route --> page : Response
@enduml
