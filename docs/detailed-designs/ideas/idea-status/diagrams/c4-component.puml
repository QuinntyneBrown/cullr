@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Idea status

Container_Boundary(spa, "Cullr web app") {
  Component(f0, "StatusControlComponent", "Angular component", "Building and Built choice")
  Component(f1, "IdeasService", "Typed HTTP service", "Sends the status change")
}
Container_Boundary(api, "Cullr API") {
  Component(a0, "status route handler", "Next.js route handler", "PUT /api/ideas/:id/status")
  Component(a1, "SetIdeaStatusUseCase", "Application", "Sets status and appends history")
  Component(a2, "Idea", "Domain entity", "Holds status and history")
  Component(a3, "StatusPolicy", "Domain policy", "Automatic transition rules")
  Component(r, "IdeaRepository", "Infrastructure", "Persist and load state")
}
ContainerDb(db, "Cullr database", "<TO SUPPLY>", "Persists state")

Rel(f0, f1, "Calls")
Rel(f1, a0, "Sends request", "JSON/HTTPS")
Rel(a0, a1, "Invokes")
Rel(a1, a2, "Uses")
Rel(a1, a3, "Uses")
Rel(a1, r, "Loads and saves through")
Rel(r, db, "Reads and writes", "<TO SUPPLY>")
@enduml
