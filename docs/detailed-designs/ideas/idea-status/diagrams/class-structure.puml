@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Idea status

class StatusControlComponent {
  +current: Status
  +options: Building | Built
  +state: default | confirming | submitting | error
  +choose(status: Status): void
  +confirm(): void
  +retry(): void
}
class IdeasService {
  +setStatus(id: string, status: Status): Observable<Idea>
}
class StatusRouteHandler {
  +PUT(request: Request, id: string): Response
}
class SetIdeaStatusUseCase {
  +execute(id: string, status: Status): Idea
}
class Idea {
  +status: Status
  +history: StatusHistoryEntry[]
  +setStatus(status: Status, now: Date): void
}
class StatusHistoryEntry {
  +description: string
  +occurredAt: Date
}
class StatusPolicy {
  +afterNotesSaved(idea: Idea): Status
  +afterCurated(idea: Idea): Status
}
enum Status {
  Logged
  Critiquing
  Curating
  Building
  Built
}
interface IdeaRepository {
  +find(id: string): Idea | null
  +save(idea: Idea): void
}
StatusControlComponent --> IdeasService : calls
IdeasService ..> StatusRouteHandler : HTTPS
StatusRouteHandler --> SetIdeaStatusUseCase : invokes
SetIdeaStatusUseCase --> Idea : updates
SetIdeaStatusUseCase --> IdeaRepository
Idea "1" *-- "*" StatusHistoryEntry
Idea --> Status
StatusPolicy ..> Idea : reads
@enduml
