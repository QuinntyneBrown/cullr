@startuml
title UML sequence behaviour — Set status manually
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Cullr web app" #E0F2FE
  participant "StatusControlComponent" as page
  participant "IdeasApiClient" as client
end box
box "Backend — Cullr API" #D1FADF
  participant "status route handler" as route
end box
box "Backend — Cullr Application and Domain" #ECFDF3
  participant "SetIdeaStatusUseCase" as uc
  participant "Idea" as idea
end box
box "Backend — Cullr Infrastructure" #FFF4E5
  database "Cullr database" as db
end box
owner -> page : Open the status control
page --> owner : Offer exactly Building and Built (L2-052)
owner -> page : Choose a status and confirm
page -> client : Build request
client -> route : PUT /api/ideas/:id/status
route -> uc : Invoke SetIdeaStatusUseCase
uc -> db : Load idea
db --> uc : Idea
alt idea archived
  uc --> route : Rejected
  route --> client : 409
  client --> page : Rejected
  page --> owner : Show failure message
else same status as current
  uc --> route : Unchanged
  route --> client : 200
  client --> page : No change
  page --> owner : Show current status, no history entry (L2-052)
else different status
  uc -> idea : setStatus and append history entry (L2-014)
  idea --> uc : Updated idea
  uc -> db : Save
  db --> uc : Saved
  uc --> route : Idea
  route --> client : 200
  client --> page : Success
  page --> owner : Show new status and success notification
end
opt save fails
  client --> page : Failure
  page --> owner : Keep previous status, show failure message with retry (L2-052)
end
@enduml
